#!/bin/sh

# sudo not required for some system commands
for command in mount umount sv emerge updatedb su shutdown poweroff reboot ; do
  alias $command="sudo $command"
done; unset command

# pacman: sudo only for operations that write; queries stay unprivileged
# (a blanket sudo alias also leaks into non-interactive shells with no sudo cache)
pacman() {
  case "$1" in
    ""|-Q*|-T*|-S[silgp]*|-F|-F[!y]*|-V|-h|--help|--version|--query*|--files*)
      command pacman "$@" ;;
    *) sudo pacman "$@" ;;
  esac
}

# System update. On Gentoo the compilers are held back by default: llvm (for
# mesa) and gcc are ~15 min each per patch bump; llvm-runtimes track llvm's
# version. Held packages skip rebuilds too. `wup all` takes everything.
wup() {
  if [ -x /usr/bin/emerge ]; then
    if [ "$1" = all ]; then
      shift; \sudo emerge -avDuN @world "$@"
    else
      \sudo emerge -avDuN @world --exclude 'llvm-core/* llvm-runtimes/* sys-devel/gcc' "$@"
      wup_held
    fi
  elif [ -x /usr/bin/pacman ]; then
    [ "$1" = all ] && shift
    \sudo pacman -Syu "$@"
  fi
}
# installed vs newest visible for what wup holds back
wup_held() {
  for atom in $(qlist -ICSe llvm-core/llvm) sys-devel/gcc; do
    have=$(portageq best_version / "$atom")
    want=$(portageq best_visible / ebuild "$atom")
    [ "$have" = "$want" ] || echo "held back: $have -> ${want##*/}"
  done
}

