#!/bin/sh

# First deploy on a machine: materialize the untracked secrets seam.
[ -f "$HOME/.config/shell/profile.local" ] ||
  install -m 600 "$HOME/.config/shell/profile.local.template" \
    "$HOME/.config/shell/profile.local" 2>/dev/null

# Same seam for the bookmarks: bm-dirs/bm-files/bm-progs are untracked and
# per-machine, seeded from the tracked *.example when missing. A fresh seed
# regenerates the shortcut files so the aliases exist right away.
seeded=
for f in bm-dirs bm-files bm-progs; do
  [ -f "$HOME/.config/shell/$f" ] ||
    { cp "$HOME/.config/shell/$f.example" "$HOME/.config/shell/$f" 2>/dev/null && seeded=1; }
done
[ -n "$seeded" ] &&
  XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}" "$HOME/.scripts/shortcuts" >/dev/null 2>&1

# README.md and LICENSE stay tracked at the repo root for GitHub, but are
# never materialized in $HOME. Re-applied on every pull so each machine
# picks the rule up without a manual bootstrap; idempotent.
command -v yadm >/dev/null 2>&1 &&
  yadm sparse-checkout set --no-cone '/*' '!/README.md' '!/LICENSE' >/dev/null 2>&1

# yadm runs its own alt *after* this hook, so reloading here would race the
# machine.conf symlink being recreated. Force alt first, then reload: alt is
# idempotent, and its own post_alt hook does the reload.
command -v yadm >/dev/null 2>&1 && yadm alt >/dev/null 2>&1
command -v hyprctl >/dev/null 2>&1 || exit 0
hyprctl reload >/dev/null 2>&1 || true
