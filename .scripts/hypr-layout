#!/bin/sh

# Switch Hyprland layouts like the old dwm binds and publish the matching
# dwm glyph to /tmp/hyprlayout for the waybar custom/layout module.
# deck/monocle have no true Hyprland equivalent; they fall back to master
# (use fullscreen/maximize binds for the monocle feel).

set -eu

usage="usage: hypr-layout tile|bstack|spiral|dwindle|deck|monocle|centered|centerfloat"

case "${1:?$usage}" in
  tile)
    hyprctl keyword general:layout master >/dev/null
    hyprctl dispatch layoutmsg orientationleft >/dev/null
    icon='[]=' ;;
  bstack)
    hyprctl keyword general:layout master >/dev/null
    hyprctl dispatch layoutmsg orientationtop >/dev/null
    icon='TTT' ;;
  spiral)
    hyprctl keyword general:layout dwindle >/dev/null
    hyprctl keyword dwindle:force_split 0 >/dev/null
    icon='[@]' ;;
  dwindle)
    hyprctl keyword general:layout dwindle >/dev/null
    hyprctl keyword dwindle:force_split 2 >/dev/null
    icon='[\]' ;;
  deck)
    hyprctl keyword general:layout master >/dev/null
    hyprctl dispatch layoutmsg orientationleft >/dev/null
    icon='[D]' ;;
  monocle)
    hyprctl keyword general:layout master >/dev/null
    icon='[M]' ;;
  centered)
    hyprctl keyword general:layout master >/dev/null
    hyprctl dispatch layoutmsg orientationcenter >/dev/null
    icon='|M|' ;;
  centerfloat)
    hyprctl keyword general:layout master >/dev/null
    hyprctl dispatch layoutmsg orientationcenter >/dev/null
    icon='>M>' ;;
  *) echo "$usage" >&2; exit 1 ;;
esac

printf '%s' "$icon" > /tmp/hyprlayout
barsig 8
