#!/bin/sh

# Generate KEYBINDINGS.md (and with --pdf also KEYBINDINGS.pdf via typst) at
# the repo root from the Hyprland config. Top-level `# comment` lines become
# section titles; a trailing " # comment" on a bind line becomes its
# description. Output order follows config order so CI can diff it.
#
# Usage: hypr-keybindings-doc [-c config] [--pdf]

set -eu

script_dir="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$script_dir/.." && pwd)"

conf="$HOME/.config/hypr/hyprland.conf"
# In-repo / CI use: fall back to the copy next to this script.
[ -f "$conf" ] || conf="$root/.config/hypr/hyprland.conf"
pdf=0

while [ $# -gt 0 ]; do
  case "$1" in
    -c) conf="$2"; shift 2 ;;
    --pdf) pdf=1; shift ;;
    *) echo "usage: hypr-keybindings-doc [-c config] [--pdf]" >&2; exit 1 ;;
  esac
done

[ -f "$conf" ] || { echo "config not found: $conf" >&2; exit 1; }

# emit md|typ: parse bind lines and render markdown tables or typst rows.
emit() {
  awk -v mode="$1" '
  function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
  function humankey(k) {
    k = trim(k)
    if (k == "mouse:272") return "LMB"
    if (k == "mouse:273") return "RMB"
    if (k == "mouse_up") return "Scroll Up"
    if (k == "mouse_down") return "Scroll Down"
    if (k == "Return") return "Enter"
    if (k == "space") return "Space"
    if (k == "semicolon") return ";"
    if (k == "apostrophe") return "\x27"
    if (k == "bracketleft") return "["
    if (k == "bracketright") return "]"
    if (k == "backslash") return "\\"
    if (k == "grave") return "`"
    if (k == "minus") return "-"
    if (k == "equal") return "="
    if (k == "comma") return ","
    if (k == "period") return "."
    if (k == "Prior") return "PgUp"
    if (k == "Next") return "PgDn"
    if (length(k) == 1) return toupper(k)
    return k
  }
  function humanmods(m) {
    m = trim(m)
    gsub(/\$mod/, "Super", m)
    gsub(/SHIFT/, "Shift", m)
    gsub(/CTRL|CONTROL/, "Ctrl", m)
    gsub(/ALT/, "Alt", m)
    gsub(/[ \t]+/, " + ", m)
    return m
  }
  # markdown code span; use double backticks when content has a backtick
  function code(s) {
    gsub(/\|/, "\\|", s)
    if (s ~ /`/) return "`` " s " ``"
    return "`" s "`"
  }
  # typst raw("...") string literal
  function typstr(s) {
    gsub(/\\/, "\\\\", s)
    gsub(/"/, "\\\"", s)
    return "raw(\"" s "\")"
  }
  # Resolve hyprlang $vars ($browser -> google-chrome-stable) so the doc names
  # the command a reader would actually type, not the indirection. Definitions
  # sit at the top of the config, so a single pass sees them before any bind.
  # The identifier regex is greedy, so $browser never matches as $b + "rowser".
  function expand(s,   out, pre, name, rest) {
    out = ""
    while (match(s, /\$[A-Za-z_][A-Za-z0-9_]*/)) {
      pre  = substr(s, 1, RSTART - 1)
      name = substr(s, RSTART + 1, RLENGTH - 1)
      rest = substr(s, RSTART + RLENGTH)
      out  = out pre ((name in vars) ? vars[name] : "$" name)
      s    = rest
    }
    return out s
  }
  function open_section(t) {
    if (mode == "md") {
      print ""
      print "## " t
      print ""
      print "| Keys | Action |"
      print "| --- | --- |"
    } else {
      print "== " t
      print "#keytable("
    }
    open = 1
  }
  function close_section() {
    if (open && mode == "typ") print ")"
    open = 0
  }
  # $name = value  -> remember it for expand() above.
  /^\$[A-Za-z_][A-Za-z0-9_]* *=/ {
    name = $0; sub(/^\$/, "", name); sub(/ *=.*/, "", name)
    val  = $0; sub(/^[^=]*= */, "", val); sub(/[ \t]+#.*$/, "", val)
    vars[trim(name)] = trim(val)
    next
  }
  /^# / { pending = substr($0, 3); next }
  /^bind[lem]* *=/ {
    line = $0
    desc = ""
    if (match(line, / # /)) {
      desc = substr(line, RSTART + 3)
      line = substr(line, 1, RSTART - 1)
    }
    sub(/^bind[a-z]* *= */, "", line)
    n = split(line, p, ",")
    mods = humanmods(p[1])
    key = humankey(p[2])
    disp = trim(p[3])
    args = ""
    for (i = 4; i <= n; i++) args = args (i > 4 ? "," : "") p[i]
    args = trim(args)

    keys = (mods == "") ? key : mods " + " key
    action = (disp == "exec") ? args : (args == "" ? disp : disp " " args)
    action = expand(action)
    if (desc != "") action = action "  (" desc ")"

    if (pending != "") { close_section(); open_section(pending); pending = "" }
    if (!open) open_section("Other")
    if (mode == "md") print "| " code(keys) " | " code(action) " |"
    else print "  " typstr(keys) ", " typstr(action) ","
  }
  END { close_section() }
  ' "$conf"
}

md="$root/KEYBINDINGS.md"
{
  echo "# Keybindings"
  echo
  echo "<!-- auto-generated by .scripts/hypr-keybindings-doc from .config/hypr/hyprland.conf — do not edit -->"
  emit md
} > "$md"
echo "wrote $md"

[ "$pdf" -eq 1 ] || exit 0

if ! command -v typst >/dev/null 2>&1; then
  echo "typst not found, skipping pdf"
  exit 0
fi

typ="${TMPDIR:-/tmp}/keybindings-$$.typ"
trap 'rm -f "$typ"' EXIT

{
  # Print doc: light theme, Tokyo Night accent headings, striped tables.
  cat <<EOF
#set page(margin: 2cm)
#set text(size: 10pt)
// "Freeze" is the real family name: the vendored font is fontfreeze-patched.
// typst reads font files directly instead of going through fontconfig, so the
// /etc/fonts alias that fixes waybar does nothing here and the family has to be
// named exactly. Plain "FiraCode Nerd Font" is deliberately not listed - it
// exists only as that fontconfig alias, so in typst it can never match and just
// emits an unknown-family warning. DejaVu Sans Mono covers CI, which has
// neither font installed.
#show raw: set text(font: ("FiraCode Nerd Font Freeze", "DejaVu Sans Mono"), size: 9pt)
#show heading.where(level: 1): set text(fill: rgb("#7AA2F7"))
#let keytable(..rows) = table(
  columns: (auto, 1fr),
  stroke: none,
  inset: (x: 8pt, y: 5pt),
  fill: (_, row) => if row == 0 { rgb("#dfe3f0") }
    else if calc.odd(row) { rgb("#f3f4f8") }
    else { white },
  table.header(text(weight: "bold")[Keys], text(weight: "bold")[Action]),
  ..rows,
)
#align(center)[
  #text(size: 22pt, weight: "bold")[Keybindings]
  #linebreak()
  #text(size: 9pt, fill: luma(120))[Generated $(date '+%Y-%m-%d') by hypr-keybindings-doc]
]
EOF
  # Sections come out as level-2 "==" headings; promote to level 1 for styling.
  emit typ | sed 's/^== /= /'
} > "$typ"

typst compile "$typ" "$root/KEYBINDINGS.pdf"
echo "wrote $root/KEYBINDINGS.pdf"
