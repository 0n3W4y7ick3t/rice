#!/bin/sh

# Gives a wmenu prompt to mount unmounted disk partitions (USB, SATA,
# NVMe — anything lsblk shows without a mountpoint) and MTP devices
# (Android phones, Garmin watches — anything aft-mtp-cli -l sees). If
# they're in /etc/fstab, they'll be mounted automatically. Otherwise,
# you'll be prompted to give a mountpoint from already existsing
# directories. If you input a novel directory, it will prompt you to
# create that directory.

getmount() { \
  [ -z "$chosen" ] && exit 1
  # shellcheck disable=SC2086
  mp="$(find $1 2>/dev/null | wmenu -i -p "Type in mount point.")" || exit 1
  test -z "$mp" && exit 1
  if [ ! -d "$mp" ]; then
    mkdiryn=$(printf "No\\nYes" | wmenu -i -p "$mp does not exist. Create it?") || exit 1
    [ "$mkdiryn" = "Yes" ] && (mkdir -p "$mp" || sudo -A mkdir -p "$mp")
  fi
}

mountdisk() { \
  chosen="$(echo "$diskdrives" | wmenu -i -p "Mount which drive?")" || exit 1
  chosen="$(echo "$chosen" | awk '{print $1}')"
  sudo -A mount "$chosen" 2>/dev/null && notify-send "💻 Disk mounting" "$chosen mounted." && exit 0
  alreadymounted=$(lsblk -nrpo "name,type,mountpoint" | awk '$3!~/\/boot|\/home$|SWAP/&&length($3)>1{printf "-not ( -path *%s -prune ) ",$3}')
  getmount "/mnt /media $HOME -maxdepth 5 -type d $alreadymounted"
  partitiontype="$(lsblk -no "fstype" "$chosen")"
  case "$partitiontype" in
    "vfat") sudo -A mount -t vfat "$chosen" "$mp" -o rw,umask=0000;;
    "exfat") sudo -A mount "$chosen" "$mp" -o uid="$(id -u)",gid="$(id -g)";;
    *) sudo -A mount "$chosen" "$mp"; user="$(whoami)"; ug="$(groups | awk '{print $1}')"; sudo -A chown "$user":"$ug" "$mp";;
  esac
  notify-send "💻 Disk mounting" "$chosen mounted to $mp."
}

mountmtp() { \
  chosen="$(echo "$mtpdrives" | wmenu -i -p "Which MTP device?")" || exit 1
  getmount "/mnt /media $HOME -maxdepth 3 -type d"
  if ! aft-mtp-mount -D "$chosen" "$mp" 2>/dev/null; then
    # phones only expose MTP after the on-screen Allow tap; retry once
    echo "OK" | wmenu -i -p "Unlock the device and tap Allow, then press enter" || exit 1
    aft-mtp-mount -D "$chosen" "$mp" || exit 1
  fi
  notify-send "📲 MTP mounting" "$chosen mounted to $mp."
}

asktype() { \
  choice="$(printf "Disk\\nMTP" | wmenu -i -p "Mount a disk or MTP device?")" || exit 1
  case $choice in
    Disk) mountdisk ;;
    MTP) mountmtp ;;
  esac
}

mtpdrives=$(aft-mtp-cli -l 2>/dev/null)
diskdrives="$(lsblk -rpo "name,type,size,mountpoint" | grep 'part\|rom' | awk '$4==""{printf "%s (%s)\n",$1,$3}')"

if [ -z "$diskdrives" ]; then
  [ -z "$mtpdrives" ] && echo "No disk or MTP device detected" && exit
  echo "MTP device(s) detected."
  mountmtp
else
  if [ -z "$mtpdrives" ]; then
    echo "Disk(s) detected."
    mountdisk
  else
    echo "Mountable disk(s) and MTP device(s) detected."
    asktype
  fi
fi
