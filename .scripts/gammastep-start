#!/bin/sh

# Launch gammastep with coordinates derived from the system timezone, so night
# mode follows the clock: set the timezone on arrival and sunset moves with it.
# tzdata ships coordinates for every zone in zone1970.tab, so this needs no
# network and nothing to hand-edit when travelling.
#
#   gammastep-start [gammastep args...]   launch gammastep + assert the scheme
#   gammastep-start --coords [ZONE]       print "lat:lon" and exit (dry run)
#   gammastep-start --apply               re-assert the scheme for right now
#
# Everything else (temperatures, fade, gamma) stays in config.ini; only the
# location is overridden, via -l.
#
# The colour scheme is asserted every 15 minutes instead of trusting the
# daemon's dusk/dawn edge. gammastep exits for good on one failed gamma write
# (redshift.c, "Temperature adjustment failed" -> return -1) and Hyprland
# hands its autostart children stdout and stderr on /dev/null -- on 2026-09-15
# it died that way minutes after login and the themes sat dark for eleven
# hours with nothing anywhere saying why. Now a dead daemon only pauses the
# screen tint: the loop below repairs the theme within a tick and the log says
# what happened. `pkill -x gammastep` thus stops the tint but not the theme.

zoneinfo=/usr/share/zoneinfo
fallback="35.6544:139.7447" # Tokyo, when the zone cannot be resolved

# The configured zone name. /etc/localtime comes first because neverland is
# OpenRC and has no timedatectl.
current_zone() {
	link=$(readlink -f /etc/localtime 2>/dev/null)
	case "$link" in
	"$zoneinfo"/*)
		printf '%s\n' "${link#"$zoneinfo"/}"
		return 0
		;;
	esac
	timedatectl show -p Timezone --value 2>/dev/null
}

# zone1970.tab lists canonical zones only, but /etc/localtime usually points at
# a backward-compat link ("Japan", not "Asia/Tokyo") that matches nothing there.
# Any miss is retried through tzdata.zi's link table ("L Asia/Tokyo Japan").
zone_coords() {
	[ -n "$1" ] || return 1
	coords=$(awk -v z="$1" '$3 == z { print $2; exit }' "$zoneinfo/zone1970.tab" 2>/dev/null)
	if [ -z "$coords" ]; then
		canonical=$(awk -v z="$1" \
			'($1 == "L" || $1 == "Link") && $3 == z { print $2; exit }' \
			"$zoneinfo/tzdata.zi" 2>/dev/null)
		[ -n "$canonical" ] || return 1
		coords=$(awk -v z="$canonical" '$3 == z { print $2; exit }' \
			"$zoneinfo/zone1970.tab" 2>/dev/null)
	fi
	[ -n "$coords" ] || return 1
	printf '%s\n' "$coords"
}

# ISO 6709, in either width: +DDMM+DDDMM or +DDMMSS+DDDMMSS. Splitting on the
# total length is what tells the two apart; both occur in zone1970.tab.
coords_to_latlon() {
	printf '%s\n' "$1" | awk '
	function dms(s,   sign, body, dlen, d, m, sec) {
		sign = (substr(s, 1, 1) == "-") ? -1 : 1
		body = substr(s, 2)
		# 4 or 6 digits is a latitude (2 degree digits), 5 or 7 a longitude (3)
		dlen = (length(body) == 4 || length(body) == 6) ? 2 : 3
		d = substr(body, 1, dlen) + 0
		m = substr(body, dlen + 1, 2) + 0
		sec = (length(body) > dlen + 2) ? substr(body, dlen + 3, 2) + 0 : 0
		return sign * (d + m / 60 + sec / 3600)
	}
	{
		if (length($0) == 11) latw = 5
		else if (length($0) == 15) latw = 7
		else exit 1
		printf "%.4f:%.4f\n", dms(substr($0, 1, latw)), dms(substr($0, latw + 1))
	}'
}

# Fail-soft throughout: a login must never end up without night mode.
resolve() {
	zone="${1:-$(current_zone)}"
	latlon=""
	coords=$(zone_coords "$zone") && latlon=$(coords_to_latlon "$coords")
	if [ -z "$latlon" ]; then
		printf '%s: cannot resolve %s, falling back to %s\n' \
			"${0##*/}" "${zone:-<no timezone>}" "$fallback" >&2
		latlon="$fallback"
	fi
	printf '%s\n' "$latlon"
}

# Re-assert the scheme for the current period with no daemon involved: the
# assert loop below, a pull that just seeded settings.ini (post_pull calls
# --apply), or a daemon that died hours ago. gammastep's own solar maths names
# the period (-p adjusts nothing), and "none" as the old period is what makes
# the hook fall back to the clock during a transition, exactly as at login.
apply_period() {
	hook="${XDG_CONFIG_HOME:-$HOME/.config}/gammastep/hooks/10-color-scheme"
	[ -x "$hook" ] || return 0
	# The Notice lines go to stderr, and "Transition" carries a "(Day: 12.3%)"
	# tail, so keep the first word only.
	period=$(gammastep -l "$(resolve)" -p 2>&1 >/dev/null |
		awk -F'Period: ' '/Period: /{ split($2, p, " "); print tolower(p[1]); exit }')
	[ -n "$period" ] || return 1
	# One log line per actual correction, none while everything is right. The
	# scheme mapping is the hook's business; this repeats it only to log.
	case "$period" in
	night) want=prefer-dark ;;
	daytime) want=prefer-light ;;
	*) want= ;;
	esac
	if [ -n "$want" ] && command -v gsettings >/dev/null 2>&1; then
		now=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)
		[ "$now" = "'$want'" ] ||
			printf '%s: asserting %s (was %s)\n' "$(date +%FT%T)" "$want" "$now"
	fi
	"$hook" period-changed none "$period"
}

case "$1" in
--coords)
	shift
	resolve "$1"
	exit 0
	;;
--apply)
	apply_period
	exit
	;;
esac

log="${XDG_CACHE_HOME:-$HOME/.cache}/gammastep.log"
mkdir -p "${log%/*}"
[ -f "$log" ] && mv -f "$log" "$log.old"
exec >"$log" 2>&1

# hyprsunset autostarts alongside us, so at login the first apply below can beat
# its IPC socket by a few hundred ms and warm nothing until the next tick. Wait
# briefly for it so a night login is dark *and* warm at once. Bounded and
# fail-soft: skipped when hyprsunset is absent, and it gives up after ~3s rather
# than hold the theme hostage to the tint.
if command -v hyprsunset >/dev/null 2>&1 && command -v hyprctl >/dev/null 2>&1; then
	n=0
	while [ "$n" -lt 30 ] && ! hyprctl hyprsunset temperature >/dev/null 2>&1; do
		sleep 0.1
		n=$((n + 1))
	done
fi

# The tint daemon, and the instant dusk/dawn flip through its period hook.
# Deliberately not respawned: if it dies the log records it, the tint waits
# for the next login, and the theme below does not care.
gammastep -l "$(resolve)" "$@" &

# Level-triggered theme correctness. Apply first, so a login where gammastep
# is too broken to fire its startup hook still gets the right scheme at once.
# GS_ASSERT_SECS exists so tests need not wait 15 minutes.
while :; do
	apply_period
	sleep "${GS_ASSERT_SECS:-900}"
done
