# git sparse-checkout patterns for servers (non-cone mode).
# Apply with:
#   yadm sparse-checkout init --no-cone
#   yadm sparse-checkout set --no-cone --stdin < ~/.config/yadm/sparse-checkout.server
# Format: `/*` includes everything, `!` lines carve out GUI-only trees.

/*

# GUI config trees
!/.config/hypr/
!/.config/waybar/
!/.config/kitty/
!/.config/kanshi/
!/.config/fcitx5/
!/.config/mpv/
!/.config/mpd/
!/.config/ncmpcpp/
!/.config/nsxiv/
!/.config/zathura/
!/.config/dunst/
!/.config/gammastep/
!/.config/wal/
!/.scripts/statusbar/
!/.local/share/applications/

# GUI scripts
!/.scripts/wmenu
!/.scripts/wmenubooks
!/.scripts/wmenuhandler
!/.scripts/wmenumount
!/.scripts/wmenumountcifs
!/.scripts/wmenupass
!/.scripts/wmenurecord
!/.scripts/wmenuscreenshots
!/.scripts/wmenuumount
!/.scripts/wmenuunicode
!/.scripts/setbg
!/.scripts/ranbg
!/.scripts/blurlock
!/.scripts/screenshot
!/.scripts/snippets-type
!/.scripts/clippick
!/.scripts/passmenu
!/.scripts/barsig
!/.scripts/hypr-layout
!/.scripts/hypr-gaps
!/.scripts/sysact
!/.scripts/samedir
!/.scripts/clip
!/.scripts/copy2clipboard
!/.scripts/otp
!/.scripts/playback-control
!/.scripts/pauseallmpv
