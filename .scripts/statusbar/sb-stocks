#!/bin/sh

# 📈 Stocks, indices, FX, VIX and commodities from Yahoo's spark endpoint
# (batched, keyless; needs a browser-ish user agent). Bar shows the day
# change of $baronly, or the level for an FX rate; left click pops the
# full watchlist, middle click refreshes now. Sends a notification when
# a symbol's day change crosses its threshold (4h cooldown; after it
# only a move that has grown by 30% of the threshold alerts again, so a
# closed market never repeats). Logos come from the logo font map (see
# ~/.scripts/build-logo-font), looked up by symbol.

# symbol label threshold% (a dash keeps the row in the popup without alerts;
# the cash indices and ETFs track the futures, so only the futures alert)
watchlist="^GSPC SPX -
ES=F SPF 1.3
^NDX NDX -
NQ=F NQF 2.08
^N225 N225 3.12
^VIX VIX 11.7
JPY=X USJPY 0.65
SPY SPY -
QQQ QQQ -
GC=F GOLD 2.6
SI=F SILV 5.85
CL=F OIL 4.55
TLT BONDS 0.91
NVDA NVDA 3.9
AAPL AAPL 2.21
GOOGL GOOGL 2.99
MSFT MSFT 2.86
AMZN AMZN 2.99
META META 3.51
TSLA TSLA 4.55"
baronly="SPF NQF N225 USJPY"
signal=13
cooldown=14400

# per-machine overrides (untracked seam, like ~/.zshrc.local):
# set sb_stocks_baronly there to change what this machine's bar shows
seam="${XDG_CONFIG_HOME:-$HOME/.config}/shell/statusbar.local"
[ -f "$seam" ] && . "$seam"
baronly="${sb_stocks_baronly:-$baronly}"

cache="${XDG_CACHE_HOME:-$HOME/.cache}/sb-stocks"
datafile="$cache/quotes.tsv" # symbol, last price, day change %
iconmap="${XDG_DATA_HOME:-$HOME/.local/share}/logos/map"
mkdir -p "$cache/alerted"

syms=$(printf '%s\n' "$watchlist" |
  awk '{gsub(/\^/, "%5E", $1); gsub(/=/, "%3D", $1); printf "%s%s", s, $1; s=","}')

geticon() { [ -f "$iconmap" ] && awk -v k="$1" '$1 == k {print $2; exit}' "$iconmap" ;}

getquotes() {
  # price = last bar, or Yahoo's fullday price when the window has no bars
  # (futures between sessions send close: null)
  if curl -sfm 7 -A "Mozilla/5.0" \
      "https://query1.finance.yahoo.com/v8/finance/spark?symbols=$syms&range=1d&interval=5m" |
    jq -r 'to_entries[] | select(.value.chartPreviousClose? != null) |
      [.key, (((.value.close // []) | map(select(. != null)) | last)
              // .value.fulldayPrice),
       .value.chartPreviousClose] | @tsv' |
    awk -F'\t' '$2 != "" && $3 > 0 {
      printf "%s\t%s\t%+.2f\n", $1, $2, ($2 - $3) / $3 * 100}' > "$datafile.tmp" &&
    [ -s "$datafile.tmp" ]; then
    mv "$datafile.tmp" "$datafile"
  else
    rm -f "$datafile.tmp"
    return 1
  fi
}

row() { awk -F'\t' -v s="$1" '$1 == s' "$datafile" ;}

fmt() { # adaptive precision: 24.8k / 6788 / 217.49
  awk -v n="$1" 'BEGIN{
    if (n >= 100000) printf "%.0fk", n/1000
    else if (n >= 10000) printf "%.1fk", n/1000
    else if (n >= 1000) printf "%.0f", n
    else printf "%.2f", n}'
}

# price prefix: indices, FX rates and index futures are quoted in points,
# not dollars, so only the rest gets a $
unit() { case $1 in \^*|*=X|ES=F|NQ=F) ;; *) printf '$' ;; esac ;}

shortlbl() { # bar-only abbreviations; popup keeps the full labels
  case $1 in SPX) echo SP ;; NDX) echo ND ;; NVDA) echo NV ;;
    *) echo "$1" ;; esac
}

showbar() {
  [ -s "$datafile" ] || return 0
  out=""
  for l in $baronly; do
    sym=$(printf '%s\n' "$watchlist" | awk -v l="$l" '$2 == l {print $1}')
    c=$(row "$sym" | cut -f3)
    [ -n "$c" ] || continue
    # logo only; the short text label steps in when no glyph exists
    icon=$(geticon "$sym")
    [ -n "$icon" ] || icon=$(shortlbl "$l")
    # FX rates show their level (you think in yen per dollar, not in
    # percent); everything else shows its day change
    case $sym in
      *=X) v=$(awk -v p="$(row "$sym" | cut -f2)" 'BEGIN{printf "%.1f", p}') ;;
      *) v=$(awk -v c="$c" 'BEGIN{printf "%+.1f", c}') ;;
    esac
    out="$out $icon$v"
  done
  [ -n "$out" ] && printf '%s\n' "${out# }"
}

# overall trend icon follows the S&P (popup title)
trend() { case $(row "^GSPC" | cut -f3) in -*) echo 📉 ;; *) echo 📈 ;; esac ;}

# alert icon from the batch itself, which may hold moves both ways
movetrend() {
  printf '%s\n' "$1" | awk '{ if ($2 ~ /^-/) d++; else u++ }
    END{ print (d && u) ? "📊" : d ? "📉" : "📈" }'
}

showall() {
  [ -s "$datafile" ] || return 0
  notify-send -t 20000 "$(trend) Markets (day)" "$(printf '%s\n' "$watchlist" |
    while read -r sym label _; do
      p=$(row "$sym" | cut -f2)
      [ -n "$p" ] || continue
      icon=$(geticon "$sym")
      printf '%s %-5s %-9s %s\n' "${icon:-  }" "$label" "$(unit "$sym")$(fmt "$p")" \
        "$(awk -v c="$(row "$sym" | cut -f3)" 'BEGIN{printf "%+.1f%%", c}')"
    done)"
}

checkalerts() {
  [ -s "$datafile" ] || return 0
  now=$(date +%s)
  moves=$(printf '%s\n' "$watchlist" | while read -r sym label th; do
    [ "$th" = - ] && continue
    c=$(row "$sym" | cut -f3)
    [ -n "$c" ] || continue
    state="$cache/alerted/$label"
    r=$(awk -v c="$c" 'BEGIN{printf "%+.1f", c}')
    if awk -v c="$c" -v t="$th" 'BEGIN{a = c<0 ? -c : c; exit !(a >= t)}'; then
      last=0 lastr=""
      [ -f "$state" ] && { read -r last lastr < "$state" || :; }
      [ $((now - last)) -lt "$cooldown" ] && continue
      # after the cooldown only a move that has grown by 30% of the
      # threshold alerts again: a stale move still inside the window, or
      # a closed market's frozen value, stays quiet until it re-arms
      [ -n "$lastr" ] && awk -v c="$c" -v l="$lastr" -v t="$th" 'BEGIN{
        a = c<0 ? -c : c; b = l<0 ? -l : l; exit !(a < b + t*0.3)}' && continue
      printf '%s %s\n' "$now" "$r" > "$state"
      printf '%-5s %s%%  %s\n' "$label" "$r" "$(unit "$sym")$(fmt "$(row "$sym" | cut -f2)")"
    else
      awk -v c="$c" -v t="$th" 'BEGIN{a = c<0 ? -c : c; exit !(a < t*0.8)}' &&
        rm -f "$state"
    fi
  done)
  [ -n "$moves" ] && notify-send "$(movetrend "$moves") Big move (day)" "$moves"
}

case $BLOCK_BUTTON in
  1) showall; exit ;;
  2) if getquotes; then
       barsig $signal
       notify-send -u low "📈 Markets updated."
     else
       notify-send -u low "📈 Markets update failed."
     fi; exit ;;
  3) notify-send "📈 Markets module" "\- Shows $baronly day change (FX: level).
- Left click: full watchlist with prices.
- Middle click: update now.
- Alerts when a day move crosses a symbol's threshold." ; exit ;;
  6) setsid -f "$TERMINAL" -e "$EDITOR" "$0"; exit ;;
esac

# refresh when the cache is missing or about a poll interval old; on a
# failed fetch keep showing whatever we already have (like sb-forecast)
age=$(( $(date +%s) - $(stat -c %Y "$datafile" 2>/dev/null || echo 0) ))
[ "$age" -ge 290 ] && getquotes
checkalerts
showbar
