  cx="chmod +x" \
  curl="curl --user-agent 'noleak'" \
  cwd="pwd|wl-copy" \
  g="git" \
  ka="killall" \
  lg="lazygit" \
  magit="nvim -c MagitOnly" \
  ff="fastfetch" \
  ff-private="fastfetch --load-config ~/.config/fastfetch/private.jsonc" \
  o="xdg-open" \
  p="pacman" \
  shred="shred -zf" \
  s="sdcv" \
  sz="source ~/.zshrc" \
  t="tmux" \
  trem="transmission-remote" \
  vimconfig="vim ~/.config/nvim/init.vim" \
  vi="nvim -u NONE" \
  wget="wget -c --user-agent 'noleak'" \
  YT="youtube-viewer" \
  z="zathura"

# Verbosity and settings that you pretty much just always are going to want.
alias \
  bc="bc -ql" \
  cp="cp -iv" \
  ffmpeg="ffmpeg -hide_banner" \
  mv="mv -iv" \
  mkd="mkdir -pv" \
  rm="rm -vI" \
  yt="yt-dlp --embed-metadata -i" \
  yta="yt -x -f bestaudio/best"

# Colorize commands when possible.
alias \
  ccat="highlight --out-format=ansi" \
  diff="diff --color=auto" \
  grep="grep --color=auto" \
  ip="ip -color=auto" \
  ls="ls -hN --color=auto --group-directories-first" \
  la="ls -a" \
  ll="ls -l" \
  l="ls -al"

# human friendlly
alias dd="dd status=progress"
alias df="df -h"
alias du="du -h"
alias dir="dir --color=auto"
alias egrep="egrep --color=auto"
alias fgrep="fgrep --color=auto"
alias free="free -h"
alias grep="grep --color=auto"
alias vdir="vdir --color=auto"
alias groot="cd \`git rev-parse --show-toplevel\`"
# the space here make shell to check if next word is an alias too, thus make `sudo my-alias` work.
alias sudo="sudo "

se() { cd ~/.scripts; $EDITOR $(fzf) ;}
# mark a program as favorite for wmenuapps ($mod+D)
bmp() { [ $# -gt 0 ] && printf '%s\n' "$*" >> "$XDG_CONFIG_HOME/shell/bm-progs" ;}

alias \
  ref="shortcuts >/dev/null; source $XDG_CONFIG_HOME/shell/shortcutrc ; source $XDG_CONFIG_HOME/shell/zshnameddirrc" \
  weather="less -S $XDG_DATA_HOME/weatherreport" \
