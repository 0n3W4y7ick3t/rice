#!/bin/sh

# Runtime gap control, mirroring dwm's togglegaps/defaultgaps/incrgaps.
# toggle state is kept in /tmp/hyprgaps. Defaults match hyprland.conf.

set -eu

state=/tmp/hyprgaps
def_in="4 3 4 3"
def_out="10 8 10 8"

# "t r b l" -> lua css_gaps table (the lua config manager has no `keyword`;
# runtime overrides go through `hyprctl eval` + hl.config)
luagaps() {
  echo "$1" | awk '{printf "{ top = %d, right = %d, bottom = %d, left = %d }", $1, $2, $3, $4}'
}

setgaps() {
  hyprctl eval "hl.config({ general = { gaps_in = $(luagaps "$1"), gaps_out = $(luagaps "$2") } })" >/dev/null
}

# Read current gaps as "t r b l" from hyprctl (.css since the lua manager)
curgaps() { hyprctl -j getoption "general:$1" | jq -r '.css'; }

# Add a delta to all four values, clamping at 0
adjust() { echo "$1" | awk -v d="$2" '{for(i=1;i<=NF;i++){$i+=d; if($i<0)$i=0}; print}'; }

case "${1:?usage: hypr-gaps toggle|default|inc|dec|smart}" in
  toggle)
    if [ -f "$state" ] && grep -q off "$state"; then
      setgaps "$def_in" "$def_out"
      rm -f "$state"
    else
      setgaps "0 0 0 0" "0 0 0 0"
      echo off > "$state"
    fi ;;
  default)
    setgaps "$def_in" "$def_out"
    rm -f "$state" ;;
  inc)
    setgaps "$(adjust "$(curgaps gaps_in)" 3)" "$(adjust "$(curgaps gaps_out)" 3)" ;;
  dec)
    setgaps "$(adjust "$(curgaps gaps_in)" -3)" "$(adjust "$(curgaps gaps_out)" -3)" ;;
  smart)
    # dwm smartgaps: no gaps when a workspace has a single tiled window.
    # Toggled via a dynamic workspace rule; hyprctl reload clears it again.
    if [ -f "$state" ] && grep -q smart "$state"; then
      hyprctl reload >/dev/null
      rm -f "$state"
    else
      hyprctl eval 'hl.workspace_rule({ workspace = "w[tv1]", gaps_out = 0, gaps_in = 0 })' >/dev/null
      echo smart > "$state"
    fi ;;
  *) echo "usage: hypr-gaps toggle|default|inc|dec|smart" >&2; exit 1 ;;
esac
