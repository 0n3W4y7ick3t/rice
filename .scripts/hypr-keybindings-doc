#!/bin/sh

# Generate .local/share/KEYBINDINGS.md (and with --pdf also KEYBINDINGS.pdf
# next to it via typst) from the Hyprland config. It lives under .local/share
# so the deployed $HOME root stays free of non-dot files, and deliberately NOT
# in .config/hypr: the keybindings CI triggers on .config/hypr/**, so a doc
# there would re-trigger the workflow on every regenerated-doc commit.
# Top-level `-- comment` lines become section titles; a trailing " -- comment"
# on a bind line becomes its description. Output order follows config order so
# CI can diff it.
#
# Reads hyprland.lua PLUS every machine.lua##class.* alternate, each under
# its own "Machine: <class>" heading, so machine-specific binds (hyprexpo on
# the desktop) are documented instead of silently missing. The alternates are
# read, never the deployed `machine.lua` symlink: the symlink exists only on
# a deployed machine and points at one class, so using it would make the
# output depend on which machine ran the script and CI could never match.
# All files go to one awk so MOD, defined in hyprland.lua, resolves in them.
#
# The parser is line-based on purpose: one hl.bind() per line, no loops --
# the config keeps that shape so this script and the CI diff stay trivial.
#
# Usage: hypr-keybindings-doc [-c config]... [--pdf]
#   -c may be repeated; giving any -c replaces the default set entirely.

set -eu

script_dir="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$script_dir/.." && pwd)"

conf="$HOME/.config/hypr/hyprland.lua"
# In-repo / CI use: fall back to the copy next to this script.
[ -f "$conf" ] || conf="$root/.config/hypr/hyprland.lua"
pdf=0
confs=""

while [ $# -gt 0 ]; do
  case "$1" in
    -c) confs="$confs$2
"; shift 2 ;;
    --pdf) pdf=1; shift ;;
    *) echo "usage: hypr-keybindings-doc [-c config]... [--pdf]" >&2; exit 1 ;;
  esac
done

if [ -n "$confs" ]; then
  conf="$(printf '%s' "$confs" | head -n1)"   # first -c is the primary
else
  confs="$conf
"
  # Sorted by the glob, so the order is the same here and in CI.
  for m in "$(dirname "$conf")"/machine.lua##class.*; do
    [ -f "$m" ] && confs="$confs$m
"
  done
fi

[ -f "$conf" ] || { echo "config not found: $conf" >&2; exit 1; }

# emit md|typ: parse hl.bind lines and render markdown tables or typst rows.
emit() {
  mode="$1"
  # $confs is a newline-separated list built above; split it into args.
  oldifs="$IFS"; IFS='
'
  # shellcheck disable=SC2086  # deliberate split on the newline IFS
  set -- $confs
  IFS="$oldifs"
  awk -v mode="$mode" -v main="$conf" '
  function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
  function humankey(k) {
    k = trim(k)
    if (k == "mouse:272") return "LMB"
    if (k == "mouse:273") return "RMB"
    if (k == "mouse_up") return "Scroll Up"
    if (k == "mouse_down") return "Scroll Down"
    if (k == "Return") return "Enter"
    if (k == "space") return "Space"
    if (k == "semicolon") return ";"
    if (k == "apostrophe") return "\x27"
    if (k == "bracketleft") return "["
    if (k == "bracketright") return "]"
    if (k == "backslash") return "\\"
    if (k == "grave") return "`"
    if (k == "minus") return "-"
    if (k == "equal") return "="
    if (k == "comma") return ","
    if (k == "period") return "."
    if (k == "Prior") return "PgUp"
    if (k == "Next") return "PgDn"
    if (length(k) == 1) return toupper(k)
    return k
  }
  # keys arrive already " + "-joined ("SUPER + SHIFT + K"); prettify the mods.
  function humanmods(m) {
    gsub(/SUPER/, "Super", m)
    gsub(/SHIFT/, "Shift", m)
    gsub(/CTRL|CONTROL/, "Ctrl", m)
    gsub(/ALT/, "Alt", m)
    return m
  }
  # markdown code span; use double backticks when content has a backtick
  function code(s) {
    gsub(/\|/, "\\|", s)
    if (s ~ /`/) return "`` " s " ``"
    return "`" s "`"
  }
  # typst raw("...") string literal
  function typstr(s) {
    gsub(/\\/, "\\\\", s)
    gsub(/"/, "\\\"", s)
    return "raw(\"" s "\")"
  }
  # Resolve a lua concat expression: split on .., unquote string pieces,
  # substitute known variables (MOD -> SUPER, term -> kitty, ...) so the doc
  # names the command a reader would actually type, not the indirection.
  # Definitions sit at the top of the config, so a single pass sees them
  # before any bind.
  function resolve(expr,   out, n, parts, i, p) {
    n = split(expr, parts, /\.\./)
    out = ""
    for (i = 1; i <= n; i++) {
      p = trim(parts[i])
      if (p ~ /^"/) { sub(/^"/, "", p); sub(/"$/, "", p) }
      else if (p in vars) p = vars[p]
      out = out p
    }
    return out
  }
  function open_section(t) {
    if (mode == "md") {
      print ""
      print "## " t
      print ""
      print "| Keys | Action |"
      print "| --- | --- |"
    } else {
      print "== " t
      print "#keytable("
    }
    open = 1
  }
  function close_section() {
    if (open && mode == "typ") print ")"
    open = 0
  }
  # Each extra config opens its own "Machine: <class>" section. Held in mach
  # rather than opened here, so a class with no binds at all (x13) does not
  # emit an empty table, and so the file own prose comments cannot clobber
  # the heading the way a plain `pending` would.
  FNR == 1 && FILENAME != main {
    mach = FILENAME
    sub(/.*##class\./, "", mach)
    mach = "Machine: " mach
    pending = ""; cmt = 0
  }
  # Section titles are standalone top-level "-- Foo" lines. A comment BLOCK of
  # two or more lines is prose and must not open a section (see the .conf-era
  # version of this script for the stale-heading incident that rule fixed).
  # Indented comments inside hl.config tables never match: ^-- is anchored.
  !/^--/ { cmt = 0 }
  /^--/  { cmt++ }
  # variable definitions: `local term = "kitty"` and the MOD global.
  /^local [A-Za-z_][A-Za-z0-9_]* *= *"/ {
    name = $0; sub(/^local +/, "", name); sub(/ *=.*/, "", name)
    val = $0; sub(/^[^=]*= *"/, "", val); sub(/".*$/, "", val)
    vars[trim(name)] = val
    next
  }
  /^[A-Za-z_][A-Za-z0-9_]* *= *"/ {
    name = $0; sub(/ *=.*/, "", name)
    val = $0; sub(/^[^=]*= *"/, "", val); sub(/".*$/, "", val)
    vars[trim(name)] = val
    next
  }
  /^-- / { pending = (cmt == 1) ? substr($0, 4) : ""; next }
  /^hl\.bind\(/ {
    line = $0
    desc = ""
    if (match(line, / -- /)) {
      desc = substr(line, RSTART + 4)
      line = substr(line, 1, RSTART - 1)
    }
    sub(/^hl\.bind\(/, "", line)
    sub(/\)[ \t]*$/, "", line)          # closing paren of hl.bind
    idx = index(line, ",")
    keyexpr = substr(line, 1, idx - 1)
    action = trim(substr(line, idx + 1))
    sub(/, *\{[^{}]*\}$/, "", action)   # flags table (locked/repeating/mouse)

    keys = resolve(keyexpr)
    n = split(keys, kp, / \+ /)
    key = humankey(kp[n])
    mods = ""
    for (i = 1; i < n; i++) mods = mods (i > 1 ? " + " : "") trim(kp[i])
    mods = humanmods(mods)
    keys = (mods == "") ? key : mods " + " key

    if (action ~ /^function\(\)/) {
      # lua-function bind: the trailing comment is the only readable rendering
      action = (desc != "") ? desc : "lua function"
      desc = ""
    } else {
      sub(/^hl\.dsp\./, "", action)
      name = action; sub(/\(.*/, "", name)
      args = action; sub(/^[^(]*\(/, "", args); sub(/\)$/, "", args)
      if (name == "exec_cmd") {
        action = resolve(args)
      } else {
        gsub(/[{}"]/, "", args)
        gsub(/ *= */, "=", args)
        gsub(/, */, " ", args)
        args = trim(args)
        action = (args == "") ? name : name " " args
      }
    }
    if (desc != "") action = action "  (" desc ")"

    if (mach != "") { close_section(); open_section(mach); mach = ""; pending = "" }
    else if (pending != "") { close_section(); open_section(pending); pending = "" }
    if (!open) open_section("Other")
    if (mode == "md") print "| " code(keys) " | " code(action) " |"
    else print "  " typstr(keys) ", " typstr(action) ","
  }
  END { close_section() }
  ' "$@"
}

md="$root/.local/share/KEYBINDINGS.md"
{
  echo "# Keybindings"
  echo
  echo "<!-- auto-generated by .scripts/hypr-keybindings-doc from .config/hypr/hyprland.lua — do not edit -->"
  emit md
} > "$md"
echo "wrote $md"

[ "$pdf" -eq 1 ] || exit 0

if ! command -v typst >/dev/null 2>&1; then
  echo "typst not found, skipping pdf"
  exit 0
fi

typ="${TMPDIR:-/tmp}/keybindings-$$.typ"
trap 'rm -f "$typ"' EXIT

{
  # Print doc: light theme, Tokyo Night accent headings, striped tables.
  cat <<EOF
#set page(margin: 2cm)
#set text(size: 10pt)
// "Freeze" is the real family name: the vendored font is fontfreeze-patched.
// typst reads font files directly instead of going through fontconfig, so the
// /etc/fonts alias that fixes waybar does nothing here and the family has to be
// named exactly. Plain "FiraCode Nerd Font" is deliberately not listed - it
// exists only as that fontconfig alias, so in typst it can never match and just
// emits an unknown-family warning. DejaVu Sans Mono covers CI, which has
// neither font installed.
#show raw: set text(font: ("FiraCode Nerd Font Freeze", "DejaVu Sans Mono"), size: 9pt)
#show heading.where(level: 1): set text(fill: rgb("#7AA2F7"))
#let keytable(..rows) = table(
  columns: (auto, 1fr),
  stroke: none,
  inset: (x: 8pt, y: 5pt),
  fill: (_, row) => if row == 0 { rgb("#dfe3f0") }
    else if calc.odd(row) { rgb("#f3f4f8") }
    else { white },
  table.header(text(weight: "bold")[Keys], text(weight: "bold")[Action]),
  ..rows,
)
#align(center)[
  #text(size: 22pt, weight: "bold")[Keybindings]
  #linebreak()
  #text(size: 9pt, fill: luma(120))[Generated $(date '+%Y-%m-%d') by hypr-keybindings-doc]
]
EOF
  # Sections come out as level-2 "==" headings; promote to level 1 for styling.
  emit typ | sed 's/^== /= /'
} > "$typ"

typst compile "$typ" "$root/.local/share/KEYBINDINGS.pdf"
echo "wrote $root/.local/share/KEYBINDINGS.pdf"
