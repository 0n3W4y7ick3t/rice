#!/bin/zsh
# profile file. Runs on login. Environmental variables are set here.

export MAKEFLAGS="-j $(grep processor /proc/cpuinfo | wc -l)"
export LANG=en_US.UTF-8
export TIME_STYLE='+%y/%m/%d %H:%M:%S'
export HIST_STAMPS="yyyy-mm-dd"

unsetopt PROMPT_SP

# Default programs:
export EDITOR="nvim"
export TERMINAL="kitty"
export IMG_VIEWER="nsxiv"
export BROWSER="google-chrome-stable"
export APPH=""
export APPJ=""
export APPK="code"
export LOCATION="Tokyo" # for wttr.in weather reports

# ~/ Clean-up:
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export NOTMUCH_CONFIG="$XDG_CONFIG_HOME/notmuch-config"
export GTK2_RC_FILES="$XDG_CONFIG_HOME/gtk-2.0/gtkrc-2.0"
export LESSHISTFILE="-"
export WGETRC="$XDG_CONFIG_HOME/wget/wgetrc"
export INPUTRC="$XDG_CONFIG_HOME/shell/inputrc"
#export ALSA_CONFIG_PATH="$XDG_CONFIG_HOME/alsa/asoundrc"
export GNUPGHOME="$XDG_DATA_HOME/gnupg"
export PASSWORD_STORE_DIR="$XDG_DATA_HOME/password-store"
export TMUX_TMPDIR="$XDG_RUNTIME_DIR"
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export GOPATH="$XDG_DATA_HOME/go"
export VIMWIKI_DIR="$XDG_DATA_HOME/nvim/vimwiki"
export PYTHON_VENV_DIR=$HOME/.local/share/pyenv
# export BLOG_DIR="$HOME/foo/blog"
# for script uploadlast to upload lastd screenshot file to imgur
# export IMGUR_CLIENT_ID="foo"

# Other program settings:
export GTK_THEME=Arc:dark # https://github.com/jnsh/arc-theme
export DICS="/usr/share/stardict/dic/"
export SUDO_ASKPASS="$HOME/.scripts/dmenupass"
export FZF_DEFAULT_OPTS="--layout=reverse --height 40%"
export LESS=-R
export LESS_TERMCAP_mb="$(printf '%b' '[1;31m')"
export LESS_TERMCAP_md="$(printf '%b' '[1;36m')"
export LESS_TERMCAP_me="$(printf '%b' '[0m')"
export LESS_TERMCAP_so="$(printf '%b' '[01;44;33m')"
export LESS_TERMCAP_se="$(printf '%b' '[0m')"
export LESS_TERMCAP_us="$(printf '%b' '[1;32m')"
export LESS_TERMCAP_ue="$(printf '%b' '[0m')"
export LESSOPEN="| /usr/bin/highlight -O ansi %s 2>/dev/null"
export QT_QPA_PLATFORMTHEME="gtk2"         # Have QT use gtk2 theme.
export QT_QPA_PLATFORM="wayland;xcb"       # Prefer wayland, fall back to X.
export MOZ_ENABLE_WAYLAND=1                # Native wayland Firefox.
# fcitx5 via wayland text-input-v3; no GTK/QT_IM_MODULE needed.
# export QT_IM_MODULE=fcitx only if a Qt app misbehaves.
export XMODIFIERS=@im=fcitx
export AWT_TOOLKIT="MToolkit wmname LG3D"  # May have to install wmname
export _JAVA_AWT_WM_NONREPARENTING=1       # Legacy fix for Java apps under XWayland.

export PATH=$HOME/.scripts:${$(find ~/.local/bin -type d -printf %p:)%%:}:$CARGO_HOME/bin:$GOPATH/bin:$PATH

[ ! -f $XDG_CONFIG_HOME/shell/shortcutrc ] && shortcuts >/dev/null 2>&1 &

# neverland is multi-GPU (5080 + Zen5 iGPU): pin Hyprland/aquamarine to the
# 5080. AQ_DRM_DEVICES is a colon-separated list and by-path names contain
# colons (aquamarine would split them into garbage and find no GPU at all),
# and /dev/dri/cardN is not stable across boots — so resolve the stable
# by-path link to this boot's cardN here. Fail-soft: if the node is missing
# (driver not loaded, card moved slots), leave the variable unset and let
# aquamarine probe every card — wrong primary GPU still beats no desktop.
if [ "$(uname -n)" = "neverland" ]; then
    _card="$(readlink -f /dev/dri/by-path/pci-0000:01:00.0-card 2>/dev/null)"
    [ -n "$_card" ] && [ -e "$_card" ] && export AQ_DRM_DEVICES="$_card"
    unset _card
fi

# Start Hyprland on tty1 if installed and not already running (skip on servers/WSL).
# Launch via start-hyprland, not Hyprland directly: it is a watchdog that
# supervises the compositor, and Hyprland warns loudly at startup when it is
# missing. dbus-run-session still wraps it — start-hyprland does not set up a
# session bus itself, and losing it breaks the portals, fcitx5 and dunst.
# stdout/stderr persist in ~/.cache/hyprland/session.log (one .old kept):
# without it a backend failure that exits before the crash reporter leaves
# nothing behind once the tty scrolls away.
if [ "$(tty)" = "/dev/tty1" ] && command -v start-hyprland >/dev/null 2>&1 && ! pidof -s Hyprland >/dev/null 2>&1; then
    _hlog="${XDG_CACHE_HOME:-$HOME/.cache}/hyprland/session.log"
    mkdir -p "${_hlog%/*}"
    [ -f "$_hlog" ] && mv -f "$_hlog" "$_hlog.old"
    exec dbus-run-session start-hyprland >"$_hlog" 2>&1
fi

# Switch escape and caps on a bare console, if it needs no password. keyd does
# this for every device once it is running, so this is only a fallback for a tty
# with keyd down.
#
# Guarded to real consoles and forced to succeed: this is the last statement in
# the file, so its exit status becomes $? at the first prompt. `sudo -n` fails
# whenever a password is required, which left every new shell starting at exit 1
# and lit up the prompt's red error indicator.
case "$(tty)" in
/dev/tty[0-9]*) sudo -n loadkeys "$XDG_DATA_HOME/ttymaps.kmap" 2>/dev/null || true ;;
esac
true
