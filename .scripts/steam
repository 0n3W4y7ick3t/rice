#!/bin/sh

# Steam is the flatpak here; its exported launcher sits outside PATH, so
# wmenuapps (which lists PATH executables) cannot see it. This shim gives
# it a plain name. Arguments pass through, so steam:// urls work too.

app=com.valvesoftware.Steam

if ! flatpak info "$app" >/dev/null 2>&1; then
  notify-send "steam" "flatpak $app is not installed"
  exit 1
fi

# The flatpak only sees the nvidia driver through a GL extension whose
# version matches the loaded kernel module exactly. After a driver bump and
# reboot nothing installs the new one, games fall back to the iGPU and never
# open a window. Fetch it here; fail soft so steam still starts.
if [ -r /sys/module/nvidia/version ]; then
  ver=$(tr . - < /sys/module/nvidia/version)
  ext=org.freedesktop.Platform.GL.nvidia-$ver
  if ! flatpak info --user "$ext" >/dev/null 2>&1; then
    notify-send "steam" "installing flatpak GL extension for nvidia $ver"
    flatpak install --user -y --noninteractive flathub \
      "$ext" "org.freedesktop.Platform.GL32.nvidia-$ver" >/dev/null 2>&1 ||
      notify-send -u critical "steam" "failed to install $ext"
  fi
fi

exec flatpak run "$app" "$@"
