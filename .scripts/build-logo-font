#!/usr/bin/env python3
# Builds ~/.local/share/fonts/logos.ttf: a CBDT/CBLC color bitmap font
# (the Noto Color Emoji format, rendered natively by pango/freetype)
# whose glyphs are real logos -- the top-50 cryptos by market cap (plus
# the sb-crypto watchlist regardless of rank, from CoinGecko), a set of
# famous stocks/ETFs (from financialmodelingprep), a few non-market
# logos (EXTRA below) and some composed badges: stacked ingots for
# gold/silver, the index logo with an F badge for index futures, and
# two flags for an FX pair. Alongside the font it maintains
# ~/.local/share/logos/map, an append-only "KEY GLYPH SOURCE" table that
# sb-crypto / sb-stocks / wmenuunicode use to look up a glyph at
# runtime; append-only keeps codepoints stable across rebuilds.
# Deps: python3 + fonttools + pillow. --refresh redownloads logos.
# Glyph geometry cloned from Noto's CBDT strike (ppem 109, 136x128 px).

import io, json, os, subprocess, sys, urllib.request

CRYPTO_BASE, STOCK_BASE, MISC_BASE = 0xF2000, 0xF2800, 0xF3000
COIN_TOP_N = 50
# always include the sb-crypto watchlist coins (keep in sync)
WATCH_IDS = ["bitcoin", "ethereum", "solana", "hyperliquid", "pump-fun",
             "binancecoin", "ripple", "tron", "backpack", "dogecoin", "sui",
             "zcash"]
# stocks & index-proxy ETFs: display symbol -> financialmodelingprep symbol
STOCKS = {
    # indices wear their provider's logo so the ETFs can keep their own
    "^GSPC": "SPGI", "^NDX": "NDAQ", "^DJI": "DIA", "^N225": "EWJ",
    "^VIX": "CBOE", "SPY": "SPY", "QQQ": "QQQ", "TLT": "TLT",
    "NVDA": "NVDA", "AAPL": "AAPL", "MSFT": "MSFT", "TSLA": "TSLA",
    "GOOGL": "GOOGL", "AMZN": "AMZN", "META": "META", "TSM": "TSM",
    "AVGO": "AVGO", "AMD": "AMD", "INTC": "INTC", "NFLX": "NFLX",
    "ORCL": "ORCL", "BABA": "BABA", "JPM": "JPM", "V": "V", "MA": "MA",
    "KO": "KO", "MCD": "MCD", "DIS": "DIS", "BA": "BA", "NKE": "NKE",
    "WMT": "WMT", "COST": "COST", "PG": "PG", "JNJ": "JNJ", "LLY": "LLY",
    "UNH": "UNH", "XOM": "XOM", "CVX": "CVX", "HD": "HD", "PEP": "PEP",
    "ADBE": "ADBE", "CRM": "CRM", "CSCO": "CSCO", "QCOM": "QCOM",
    "TXN": "TXN", "MU": "MU", "ASML": "ASML", "ARM": "ARM", "SMCI": "SMCI",
    "PLTR": "PLTR", "COIN": "COIN", "HOOD": "HOOD", "MSTR": "MSTR",
    "UBER": "UBER", "SHOP": "SHOP", "PYPL": "PYPL", "SOFI": "SOFI",
    "SNOW": "SNOW", "GME": "GME", "F": "F", "GM": "GM", "BAC": "BAC",
    "GS": "GS", "MS": "MS", "AXP": "AXP", "IBM": "IBM", "SBUX": "SBUX",
}
# instruments with no logo API: real color emoji straight into the map
EMOJI = {"CL=F": "🛢️", "BZ=F": "🛢️"}
# gold/silver: a stacked-ingots badge composed from a single ingot icon
# (silver is the same stack desaturated, so the pair matches)
INGOT_URL = ("https://upload.wikimedia.org/wikipedia/commons/thumb/2/24/"
             "Gold_ingot_icon.svg/330px-Gold_ingot_icon.svg.png")
BULLION = {"GC=F": "gold", "SI=F": "silver"}
# fractions (left, top, right, bottom) of a logo's own bounding box to keep:
# a wordmark much wider than the cell shrinks to a strip, so the S&P 500
# keeps just its "S&P" letters (the gap before "Global" is at 38-43%)
CROP = {"^GSPC": (0, 0, 0.40, 1)}
# index futures: the index's own logo with a small F badge in the corner
FUTURES = {"ES=F": "^GSPC", "NQ=F": "^NDX"}
# FX pairs: two flags, base currency top left, quote bottom right
FLAG_URL = "https://upload.wikimedia.org/wikipedia/commons/thumb/{}/{}.svg/330px-{}.svg.png"
FLAGS = {"US": ("a/a4", "Flag_of_the_United_States"),
         "JP": ("9/9e", "Flag_of_Japan")}
FX = {"JPY=X": ("US", "JP")}
# non-market color logos (used by the wmenuunicode picker/emoji list)
EXTRA = {
    "GENTOO": "https://upload.wikimedia.org/wikipedia/commons/thumb/4/48/Gentoo_Linux_logo_matte.svg/330px-Gentoo_Linux_logo_matte.svg.png",
    "ARCH": "https://upload.wikimedia.org/wikipedia/commons/thumb/1/13/Arch_Linux_%22Crystal%22_icon.svg/330px-Arch_Linux_%22Crystal%22_icon.svg.png",
    "KALI": "https://upload.wikimedia.org/wikipedia/commons/thumb/2/2b/Kali-dragon-icon.svg/330px-Kali-dragon-icon.svg.png",
}

PPEM, W, H, BEARING_Y = 109, 136, 128, 101
UPEM = 2048
ADVANCE = round(W * UPEM / PPEM)
OUT = os.path.expanduser("~/.local/share/fonts/logos.ttf")
DATA = os.path.join(os.environ.get("XDG_DATA_HOME",
       os.path.expanduser("~/.local/share")), "logos")
MAPFILE = os.path.join(DATA, "map")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME",
        os.path.expanduser("~/.cache")), "logo-font")


def fetch(url):
    req = urllib.request.Request(url, headers={"User-Agent": "logo-font/1.0"})
    with urllib.request.urlopen(req, timeout=25) as r:
        return r.read()


def load_map():
    entries = {}  # key -> [glyph string, source]; emoji rows are multi-char
    if os.path.exists(MAPFILE):
        for line in open(MAPFILE, encoding="utf-8"):
            if line.startswith("#") or not line.strip():
                continue
            key, ch, src = line.split()
            entries[key] = [ch, src]
    return entries


def save_map(entries):
    os.makedirs(DATA, exist_ok=True)
    with open(MAPFILE, "w", encoding="utf-8") as f:
        f.write("# KEY GLYPH SOURCE -- generated by build-logo-font;"
                " append-only, do not renumber\n")
        for key, (ch, src) in sorted(entries.items(),
                                     key=lambda e: ord(e[1][0][0])):
            f.write(f"{key} {ch} {src}\n")


def cg_markets(qs):
    return json.loads(fetch(
        "https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&" + qs))


def make_bullion(refresh):
    # compose the 2+1 stacked-ingots badges into the image cache
    from PIL import Image
    targets = {s: os.path.join(CACHE, s.replace("^", "_") + ".img")
               for s in BULLION}
    if not refresh and all(os.path.exists(p) for p in targets.values()):
        return
    base_path = os.path.join(CACHE, "_ingot.img")
    if refresh or not os.path.exists(base_path):
        open(base_path, "wb").write(fetch(INGOT_URL))
    ingot = Image.open(base_path).convert("RGBA")
    ingot.thumbnail((72, 72), Image.LANCZOS)
    wi, hi = ingot.size
    stack = Image.new("RGBA", (W, H), (0, 0, 0, 0))
    stack.alpha_composite(ingot, (W // 2 - wi + 6, H - hi))       # bottom left
    stack.alpha_composite(ingot, (W // 2 - 6, H - hi))            # bottom right
    stack.alpha_composite(ingot, (W // 2 - wi // 2, H - 2 * hi + 12))  # top
    for sym, metal in BULLION.items():
        img = stack
        if metal == "silver":
            r, g, b, a = stack.split()
            gray = Image.merge("RGB", (r, g, b)).convert("L")
            gray = gray.point(lambda v: min(255, int(v * 1.15) + 10))
            img = Image.merge("RGBA", (gray, gray,
                                       gray.point(lambda v: min(255, v + 6)), a))
        img.save(targets[sym], "PNG", optimize=True)


def badge_font(size):
    from PIL import ImageFont
    try:
        path = subprocess.run(["fc-match", "-f", "%{file}", "sans-serif:bold"],
                              capture_output=True, text=True).stdout.strip()
        return ImageFont.truetype(path, size)
    except Exception:
        return ImageFont.load_default(size)


def logo_image(key, path):
    from PIL import Image
    img = Image.open(path).convert("RGBA")
    if key in CROP:
        x0, y0, x1, y1 = img.getbbox() or (0, 0, img.width, img.height)
        bw, bh = x1 - x0, y1 - y0
        l, t, r, b = CROP[key]
        img = img.crop((x0 + round(bw * l), y0 + round(bh * t),
                        x0 + round(bw * r), y0 + round(bh * b)))
    return img


def make_futures(images):
    # the index logo shrunk a little, plus an orange F badge bottom right;
    # composed on every build so it always follows the current index logo
    from PIL import Image, ImageDraw
    for sym, base in FUTURES.items():
        if base not in images:
            continue
        path = os.path.join(CACHE, sym.replace("^", "_") + ".img")
        logo = logo_image(base, images[base])
        logo.thumbnail((H - 20, H - 20), Image.LANCZOS)
        canvas = Image.new("RGBA", (W, H), (0, 0, 0, 0))
        canvas.paste(logo, ((W - logo.width) // 2 - 8,
                            (H - logo.height) // 2 - 8), logo)
        r, cx, cy = 26, W - 28, H - 28
        draw = ImageDraw.Draw(canvas)
        draw.ellipse((cx - r, cy - r, cx + r, cy + r), fill=(245, 166, 35, 255))
        draw.text((cx, cy + 1), "F", fill="white", font=badge_font(38),
                  anchor="mm")
        canvas.save(path, "PNG", optimize=True)
        images[sym] = path


def make_fx(images, refresh):
    # two flags at their own aspect, 96 px wide, in opposite corners
    from PIL import Image
    for sym, pair in FX.items():
        path = os.path.join(CACHE, sym.replace("^", "_") + ".img")
        canvas = Image.new("RGBA", (W, H), (0, 0, 0, 0))
        for i, cc in enumerate(pair):
            fp = os.path.join(CACHE, f"_flag_{cc}.img")
            if refresh or not os.path.exists(fp):
                h, n = FLAGS[cc]
                open(fp, "wb").write(fetch(FLAG_URL.format(h, n, n)))
            flag = Image.open(fp).convert("RGBA")
            flag = flag.resize((96, round(96 * flag.height / flag.width)),
                               Image.LANCZOS)
            canvas.alpha_composite(flag, (i * (W - 96), i * (H - flag.height)))
        canvas.save(path, "PNG", optimize=True)
        images[sym] = path


def main():
    refresh = "--refresh" in sys.argv
    os.makedirs(CACHE, exist_ok=True)
    entries = load_map()

    def is_glyph(v):  # font-backed row (single PUA char), not an emoji row
        return v[1] != "emoji"

    def nextcp(base, ceiling):
        used = [ord(ch) for ch, src in entries.values()
                if src != "emoji" and base <= ord(ch[0]) < ceiling]
        return max(used) + 1 if used else base

    # crypto: top N by market cap, plus watchlist ids, plus map legacy
    coins = cg_markets(f"order=market_cap_desc&per_page={COIN_TOP_N}&page=1")
    have = {m["id"] for m in coins}
    missing = [i for i in WATCH_IDS if i not in have]
    if missing:
        coins += cg_markets("ids=" + ",".join(missing))
    img_urls = {}
    for m in coins:
        key = m["symbol"].upper()
        if key not in entries:
            entries[key] = [chr(nextcp(CRYPTO_BASE, STOCK_BASE)), "cg:" + m["id"]]
        if entries[key][1] == "cg:" + m["id"]:  # first-come keeps the key
            img_urls[key] = m["image"]
    for sym, fmp in STOCKS.items():
        if sym not in entries:
            entries[sym] = [chr(nextcp(STOCK_BASE, MISC_BASE)), "fmp:" + fmp]
        elif entries[sym][1] != "fmp:" + fmp:
            # a changed logo source refetches but keeps the codepoint
            entries[sym][1] = "fmp:" + fmp
            stale = os.path.join(CACHE, sym.replace("^", "_") + ".img")
            if os.path.exists(stale):
                os.remove(stale)
        img_urls[sym] = f"https://financialmodelingprep.com/image-stock/{fmp}.png"
    for sym, em in EMOJI.items():
        entries[sym] = [em, "emoji"]  # overwrite: emoji rows own no codepoint
    for key, url in EXTRA.items():
        if key not in entries:
            entries[key] = [chr(nextcp(MISC_BASE, 0xF3100)), "img:" + key]
        img_urls[key] = url
    for sym, metal in BULLION.items():
        if sym not in entries or entries[sym][1] == "emoji":
            entries[sym] = [chr(nextcp(MISC_BASE, 0xF3100)), "gen:" + metal]
    make_bullion(refresh)
    for sym, base in FUTURES.items():
        if sym not in entries:
            entries[sym] = [chr(nextcp(MISC_BASE, 0xF3100)), f"gen:{base}+F"]
    for sym, pair in FX.items():
        if sym not in entries:
            entries[sym] = [chr(nextcp(MISC_BASE, 0xF3100)), "gen:" + "+".join(pair)]

    # download (cache by key); a failed fetch falls back to the cached copy
    images = {}
    for key in entries:
        if not is_glyph(entries[key]):
            continue
        path = os.path.join(CACHE, key.replace("^", "_") + ".img")
        if (refresh or not os.path.exists(path)) and key in img_urls:
            try:
                open(path, "wb").write(fetch(img_urls[key]))
            except Exception as e:
                print(f"warn: {key}: {e}", file=sys.stderr)
        if os.path.exists(path):
            # an API error page cached as an "image" must not kill the build
            from PIL import Image
            try:
                Image.open(path).close()
                images[key] = path
            except Exception:
                print(f"warn: {key}: not an image, dropped", file=sys.stderr)
                os.remove(path)
    make_futures(images)
    make_fx(images, refresh)
    dropped = {k for k in entries if is_glyph(entries[k])} - set(images)
    if dropped:
        print(f"warn: no image, no glyph for: {sorted(dropped)}", file=sys.stderr)

    from PIL import Image
    pngs = {}  # glyphname -> png bytes; key order by codepoint
    names = {}
    for key in sorted(images, key=lambda k: ord(entries[k][0])):
        img = logo_image(key, images[key])
        img.thumbnail((H, H), Image.LANCZOS)
        canvas = Image.new("RGBA", (W, H), (0, 0, 0, 0))
        canvas.paste(img, ((W - img.width) // 2, (H - img.height) // 2), img)
        buf = io.BytesIO()
        canvas.save(buf, "PNG", optimize=True)
        cp = ord(entries[key][0])
        name = f"g{cp:X}"
        pngs[name] = buf.getvalue()
        names[name] = cp

    from fontTools.fontBuilder import FontBuilder
    from fontTools.ttLib.tables._g_l_y_f import Glyph
    order = [".notdef"] + list(pngs)
    fb = FontBuilder(UPEM, isTTF=True)
    fb.setupGlyphOrder(order)
    fb.setupCharacterMap({cp: n for n, cp in names.items()})
    fb.setupGlyf({g: Glyph() for g in order})
    fb.setupHorizontalMetrics({g: (ADVANCE, 0) for g in order})
    fb.setupHorizontalHeader(ascent=1900, descent=-500)
    fb.setupNameTable({
        "familyName": "logos", "styleName": "Regular",
        "copyright": "Logos are trademarks/copyright of their respective "
                     "owners. Personal, non-commercial build assembled from "
                     "CoinGecko, financialmodelingprep and Wikimedia images.",
    })
    fb.setupOS2(sTypoAscender=1900, sTypoDescender=-500,
                usWinAscent=1900, usWinDescent=500)
    fb.setupPost()

    metrics = "\n".join(
        f'      <{k} value="{v}"/>' for k, v in
        [("ascender", BEARING_Y), ("descender", BEARING_Y - H), ("widthMax", W),
         ("caretSlopeNumerator", 0), ("caretSlopeDenominator", 0),
         ("caretOffset", 0), ("minOriginSB", 0), ("minAdvanceSB", 0),
         ("maxBeforeBL", 0), ("minAfterBL", 0), ("pad1", 0), ("pad2", 0)])
    glyphs_xml, locs = [], []
    for i, (name, png) in enumerate(pngs.items(), start=1):
        hx = png.hex()
        hexdata = "\n".join(hx[j:j + 64] for j in range(0, len(hx), 64))
        glyphs_xml.append(f"""    <cbdt_bitmap_format_17 name="{name}">
      <SmallGlyphMetrics>
        <height value="{H}"/>
        <width value="{W}"/>
        <BearingX value="0"/>
        <BearingY value="{BEARING_Y}"/>
        <Advance value="{W}"/>
      </SmallGlyphMetrics>
      <rawimagedata>
{hexdata}
      </rawimagedata>
    </cbdt_bitmap_format_17>""")
        locs.append(f'      <glyphLoc id="{i}" name="{name}"/>')
    ttx = f"""<?xml version="1.0" encoding="UTF-8"?>
<ttFont>
  <CBDT>
    <header version="3.0"/>
    <strikedata index="0">
{chr(10).join(glyphs_xml)}
    </strikedata>
  </CBDT>
  <CBLC>
    <header version="3.0"/>
    <strike index="0">
      <bitmapSizeTable>
        <sbitLineMetrics direction="hori">
{metrics}
        </sbitLineMetrics>
        <sbitLineMetrics direction="vert">
{metrics}
        </sbitLineMetrics>
        <colorRef value="0"/>
        <startGlyphIndex value="1"/>
        <endGlyphIndex value="{len(pngs)}"/>
        <ppemX value="{PPEM}"/>
        <ppemY value="{PPEM}"/>
        <bitDepth value="32"/>
        <flags value="1"/>
      </bitmapSizeTable>
      <eblc_index_sub_table_1 imageFormat="17" firstGlyphIndex="1" lastGlyphIndex="{len(pngs)}">
{chr(10).join(locs)}
      </eblc_index_sub_table_1>
    </strike>
  </CBLC>
</ttFont>"""
    font = fb.font
    font.importXML(io.StringIO(ttx))
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    font.save(OUT)
    save_map(entries)
    # picker list for wmenuunicode (same "char name; comment" format)
    with open(os.path.join(DATA, "picker"), "w", encoding="utf-8") as f:
        for key, (ch, src) in sorted(entries.items(),
                                     key=lambda e: ord(e[1][0][0])):
            kind, _, ident = src.partition(":")
            desc = {"cg": "crypto", "fmp": "stock/etf", "img": "logo"}.get(
                kind) or ("index futures" if key in FUTURES else
                          "fx pair" if key in FX else "commodity")
            if ident:
                desc += " " + ident
            f.write(f"{ch} {key.lower()} {desc}; token logo\n")
    subprocess.run(["fc-cache", "-f", os.path.dirname(OUT)],
                   check=False, capture_output=True)
    from fontTools.ttLib import TTFont
    n = len(TTFont(OUT)["CBDT"].strikeData[0])
    print(f"built {OUT}: {n} glyphs ({len(entries)} mapped) -> {MAPFILE}")


if __name__ == "__main__":
    main()
