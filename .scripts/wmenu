#!/bin/sh

# wmenu wrapper: applies the Tokyo Night palette and the bar font unless the
# caller passed its own, so every menu in .scripts looks the same without
# repeating eight flags. Also still accepts the dmenu spellings (-fn -nb -nf
# -sb -sf) and drops the X-only ones, because these scripts are ports of
# Luke Smith's voidrice and upstream diffs keep arriving in dmenu form.
#
# NOTE: this file is named wmenu and $HOME/.scripts comes first in PATH, so it
# shadows /usr/bin/wmenu. It must therefore exec the real binary by absolute
# path -- a bare `exec wmenu` would find this script again and fork-bomb.

set -eu

font=0
colors=0
set -- "$@" ---end---
while [ "$1" != "---end---" ]; do
  a=$1; shift
  case "$a" in
    # "Name-Size" -> "Name Size"; wmenu exits on a bad font
    -fn) set -- "$@" -f "$(printf '%s' "$1" | sed 's/-\([0-9][0-9]*\)$/ \1/')"; shift; font=1 ;;
    -f) set -- "$@" -f "$1"; shift; font=1 ;;
    -m|-w) shift ;;  # monitor / embed window id: X-only, drop with value
    -nb) set -- "$@" -N "${1#\#}"; shift; colors=1 ;;
    -nf) set -- "$@" -n "${1#\#}"; shift; colors=1 ;;
    -sb) set -- "$@" -S "${1#\#}"; shift; colors=1 ;;
    -sf) set -- "$@" -s "${1#\#}"; shift; colors=1 ;;
    -N|-n|-S|-s|-M) set -- "$@" "$a" "$1"; shift; colors=1 ;;
    -l|-p) set -- "$@" "$a" "$1"; shift ;;
    *) set -- "$@" "$a" ;;  # -i -P -b and anything else pass through
  esac
done
shift  # drop the ---end--- marker

# defaults match waybar's style.css
[ "$font" -eq 1 ] || set -- "$@" -f "FiraCode Nerd Font 15"
[ "$colors" -eq 1 ] || set -- "$@" -N 1A1B26 -n A9B1D6 -S 7AA2F7 -s 1A1B26

for d in /usr/bin /usr/local/bin /bin; do
  [ -x "$d/wmenu" ] && exec "$d/wmenu" "$@"
done
echo "wmenu: real binary not found outside \$HOME/.scripts" >&2
exit 127
