#!/bin/sh

# Displays todays precipication chance (☔) and the current temperature
# with the daily range: 🌡️cur (low/high). Usually intended for the statusbar.

# If we have internet, get a weather report from wttr.in and store it locally.
# You could set up a shell alias to view the full file in a pager in the
# terminal if desired. This function will only be run once a day when needed.

# ignore proxys
unset http_proxy
unset https_proxy
unset all_proxy
LOCATION="${1:-$LOCATION}"
weatherreport="$XDG_DATA_HOME/weatherreport"
getforecast() { timeout --signal=1 2s curl -sf "wttr.in/$LOCATION" > "$weatherreport" || exit 1 ;}

# Some very particular and terse stream manipulation. We get the maximum
# precipitation chance, the current temperature (report line 4, first signed
# number) and the daily low/high, and display them as: ☔N% 🌡️cur (low/high).
showweather() { cur="$(sed '4q;d' "$weatherreport" |
  grep -o "m[-+][0-9]\+" | head -1 | sed 's/^m//;s/^+//')"
printf "%s" "$(sed '16q;d' "$weatherreport" |
  grep -wo "[0-9]*%" | sort -rn | sed "s/^/☔/g;1q" | tr -d '\n')"
sed '13q;d' "$weatherreport" | grep -o "m\\([-+]\\)*[0-9]\\+" | sed 's/+//g' | sort -n -t 'm' -k 2n | sed -e 1b -e '$!d' | tr '\n|m' ' ' | awk -v c="$cur" '{print " 🌡️" c " (" $1 "/" $2 ")"}' ;}

case $BLOCK_BUTTON in
  1) setsid -f "$TERMINAL" -e less -Srf "$weatherreport" ;;
  2) getforecast && showweather ;;
  3) notify-send "🌈 Weather module" "\- Left click for full forecast.
- Middle click to update forecast.
☔: Chance of rain/snow
🌡️: Current temp (daily low/high)" ;;
  6) "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# Refresh the report when it is about half an hour old (the waybar module
# polls every 1800s) or empty/missing.
age=$(( $(date +%s) - $(stat -c %Y "$weatherreport" 2>/dev/null || echo 0) ))
[ "$age" -ge 1700 ] && getforecast
[ -s "$weatherreport" ] || getforecast

showweather
