#!/bin/sh

# Switch Hyprland layouts like the old dwm binds and publish the matching
# dwm glyph to /tmp/hyprlayout for the waybar custom/layout module.
# deck/monocle have no true Hyprland equivalent; they fall back to master
# (use fullscreen/maximize binds for the monocle feel).

set -eu

usage="usage: hypr-layout tile|bstack|spiral|dwindle|deck|monocle|centered|centerfloat"

case "${1:?$usage}" in
  tile)
    hyprctl eval 'hl.config({ general = { layout = "master" } })' >/dev/null
    hyprctl dispatch 'hl.dsp.layout("orientationleft")' >/dev/null
    icon='[]=' ;;
  bstack)
    hyprctl eval 'hl.config({ general = { layout = "master" } })' >/dev/null
    hyprctl dispatch 'hl.dsp.layout("orientationtop")' >/dev/null
    icon='TTT' ;;
  spiral)
    hyprctl eval 'hl.config({ general = { layout = "dwindle" } })' >/dev/null
    hyprctl eval 'hl.config({ dwindle = { force_split = 0 } })' >/dev/null
    icon='[@]' ;;
  dwindle)
    hyprctl eval 'hl.config({ general = { layout = "dwindle" } })' >/dev/null
    hyprctl eval 'hl.config({ dwindle = { force_split = 2 } })' >/dev/null
    icon='[\]' ;;
  deck)
    hyprctl eval 'hl.config({ general = { layout = "master" } })' >/dev/null
    hyprctl dispatch 'hl.dsp.layout("orientationleft")' >/dev/null
    icon='[D]' ;;
  monocle)
    hyprctl eval 'hl.config({ general = { layout = "master" } })' >/dev/null
    icon='[M]' ;;
  centered)
    hyprctl eval 'hl.config({ general = { layout = "master" } })' >/dev/null
    hyprctl dispatch 'hl.dsp.layout("orientationcenter")' >/dev/null
    icon='|M|' ;;
  centerfloat)
    hyprctl eval 'hl.config({ general = { layout = "master" } })' >/dev/null
    hyprctl dispatch 'hl.dsp.layout("orientationcenter")' >/dev/null
    icon='>M>' ;;
  *) echo "$usage" >&2; exit 1 ;;
esac

printf '%s' "$icon" > /tmp/hyprlayout
barsig 8
